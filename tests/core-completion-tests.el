;;; core-completion-tests.el --- Completion integration tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'project)
(require 'savehist)
(require 'recentf)

(let* ((state-directory (make-temp-file "rk-completion-state-" t))
       (user-emacs-directory (file-name-as-directory state-directory))
       (savehist-file (expand-file-name "history" state-directory))
       (recentf-save-file (expand-file-name "recentf" state-directory))
       (project-list-file (expand-file-name "projects" state-directory))
       (module-directory
        (expand-file-name "../lisp/" (file-name-directory load-file-name))))
  (unwind-protect
      (progn
        (load (expand-file-name "core-keybindings.el" module-directory))
        (load (expand-file-name "core-completion.el" module-directory))
        (load (expand-file-name "core-vc.el" module-directory))
        (load (expand-file-name "core-tabs.el" module-directory))
        (require 'consult))
    (savehist-mode -1)
    (recentf-mode -1)
    (delete-directory state-directory t)))

(defmacro rk/test-with-workspaces (&rest body)
  "Run BODY with temporary files and isolated tab state."
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "rk-consult-test-" t))
          (file (expand-file-name "candidate.txt" directory))
          (tabs (copy-tree (tab-bar-tabs)))
          (rk/tab-workspace-roots nil))
     (save-window-excursion
       (unwind-protect
           (progn
             (write-region "Candidate contents\n" nil file nil 'silent)
             (tab-bar-close-other-tabs)
             (tab-bar-rename-tab "Origin")
             (rk/tab-set-workspace-root default-directory)
             ,@body)
         (when-let* ((buffer (get-file-buffer file)))
           (kill-buffer buffer))
         (set-frame-parameter nil 'tabs tabs)
         (delete-directory directory t)))))

(ert-deftest rk/consult-recent-file-routes-accepted-file ()
  (rk/test-with-workspaces
    (let ((recentf-list (list file))
          (this-command 'consult-recent-file))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _) file)))
        (consult-recent-file)))
    (should (equal (rk/tab-current-name) rk/loose-files-tab-name))
    (should (equal (buffer-file-name) file))))

(ert-deftest rk/consult-buffer-file-source-routes-accepted-file ()
  (dolist (source '(consult-source-recent-file consult-source-project-recent-file))
    (rk/test-with-workspaces
      (let ((recentf-mode t)
            (recentf-list (list file))
            (consult-project-function (lambda (_) directory))
            (this-command 'consult-buffer))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt table &rest _)
                     (car (all-completions "" table)))))
          (consult-buffer (list source))))
      (should (equal (rk/tab-current-name) rk/loose-files-tab-name))
      (should (equal (buffer-file-name) file)))))

(ert-deftest rk/consult-buffer-existing-buffer-does-not-route ()
  (rk/test-with-workspaces
    (let* ((buffer (find-file-noselect file))
           (this-command 'consult-buffer)
           (source (copy-sequence consult-source-buffer)))
      (setf (plist-get source :items) (list (buffer-name buffer)))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt table &rest _)
                   (car (all-completions "" table)))))
        (consult-buffer (list source)))
      (should (eq (current-buffer) buffer))
      (should (equal (rk/tab-current-name) "Origin")))))

(ert-deftest rk/consult-file-source-new-file-preserves-routing ()
  (dolist (source '(consult-source-recent-file consult-source-project-recent-file
                   consult-source-project-recent-file-hidden))
    (rk/test-with-workspaces
      (let ((consult-project-function (lambda (_) directory)))
        (funcall (plist-get (symbol-value source) :new)
                 (if (eq source 'consult-source-recent-file)
                     file
                   (file-name-nondirectory file))))
      (should (equal (rk/tab-current-name) rk/loose-files-tab-name))
      (should (equal (buffer-file-name) file)))))

(ert-deftest rk/consult-preview-and-cancel-preserve-workspace ()
  (rk/test-with-workspaces
    (let ((state (rk/consult-file-state))
          (origin (window-buffer))
          (roots (copy-tree rk/tab-workspace-roots)))
      (funcall state 'setup nil)
      (funcall state 'preview file)
      (should (equal (buffer-file-name (window-buffer)) file))
      (should (equal (rk/tab-current-name) "Origin"))
      (should (= (length (tab-bar-tabs)) 1))
      (should (equal rk/tab-workspace-roots roots))
      (funcall state 'preview nil)
      (funcall state 'exit nil)
      (funcall state 'return nil)
      (should (eq (window-buffer) origin))
      (should (equal (rk/tab-current-name) "Origin"))
      (should (equal rk/tab-workspace-roots roots)))))

(ert-deftest rk/consult-file-state-routes-only-local-final-selection ()
  (let (routed forwarded)
    (cl-letf (((symbol-function 'rk/tab-route-file)
               (lambda (file) (push file routed)))
              ((symbol-function 'consult--file-state)
               (lambda ()
                 (lambda (action candidate)
                   (push (list action candidate) forwarded)))))
      (let ((state (rk/consult-file-state)))
        (funcall state 'preview "/tmp/local.txt")
        (funcall state 'return nil)
        (funcall state 'return "/ssh:example:/remote.txt")
        (should-not routed)
        (funcall state 'return "/tmp/local.txt")
        (should (equal routed '("/tmp/local.txt")))
        (should (= (length forwarded) 4))))))

(ert-deftest rk/consult-project-search-requires-ripgrep ()
  (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
            ((symbol-function 'consult-ripgrep)
             (lambda (&rest _) (ert-fail "Unexpected search"))))
    (should-error (rk/consult-project-search) :type 'user-error)))

(ert-deftest rk/consult-project-search-uses-project-root ()
  (let (searched)
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "/tools/rg"))
              ((symbol-function 'project-current)
               (lambda (&rest _) '(transient . "/tmp/project/")))
              ((symbol-function 'consult-ripgrep)
               (lambda ()
                 (interactive)
                 (setq searched default-directory))))
      (rk/consult-project-search)
      (should (equal searched "/tmp/project/")))))

(ert-deftest rk/orderless-matches-terms-in-either-order ()
  (let ((candidates '("project-find-file" "project-find-regexp" "find-file")))
    (dolist (input '("file project" "project file"))
      (let ((matches (completion-all-completions
                      input candidates nil (length input))))
        (should matches)
        (setcdr (last matches) nil)
        (should (equal (mapcar #'substring-no-properties matches)
                       '("project-find-file")))))))

(ert-deftest rk/marginalia-annotates-recent-project-files ()
  (let* ((directory (make-temp-file "rk-marginalia-test-" t))
         (default-directory (file-name-as-directory directory))
         (file (expand-file-name "recent.txt" directory))
         (marginalia--project-root default-directory))
    (unwind-protect
        (progn
          (write-region "Recent file\n" nil file nil 'silent)
          (set-file-times file (time-subtract (current-time) 60))
          (dolist (annotation (list (marginalia-annotate-file file)
                                    (marginalia-annotate-project-file "recent.txt")))
            (should (string-match-p "ago" annotation))))
      (delete-directory directory t))))

(ert-deftest rk/eglot-flex-does-not-expand-ambiguous-input ()
  (let ((table (lambda (string pred action)
                 (if (eq action 'metadata)
                     '(metadata (category . eglot-capf))
                   (complete-with-action
                    action '("fooBarBaz" "fooBarQux") string pred)))))
    (should (equal (completion-try-completion "fB" table nil 2)
                   '("fB" . 2)))
    (should-not (completion-try-completion "zz" table nil 2))
    (let ((unique (completion-try-completion "fBB" table nil 3)))
      (should (equal (substring-no-properties (car unique)) "fooBarBaz")))))

(ert-deftest rk/corfu-does-not-insert-unselected-or-previewed-candidates ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "can")
    (let ((corfu--index -1))
      (cl-letf (((symbol-function 'corfu-quit) #'ignore))
        (corfu-insert)))
    (should (equal (buffer-string) "can"))
    (let ((corfu--candidates '("candidate-one" "candidate-two"))
          (corfu--index 0)
          (completion-in-region--data (list 1 (point) nil nil)))
      (corfu--preview-current (point-min) (point-max))
      (should (equal (buffer-string) "can"))
      (should-not (overlays-in (point-min) (point-max))))))

;;; core-completion-tests.el ends here
