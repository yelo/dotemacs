<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace @EMACS@ and @HOME@ before installing in ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.gnu.emacs.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>@EMACS@</string>
    <string>--fg-daemon</string>
    <string>--init-directory</string>
    <string>@HOME@/.config/emacs</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/Emacs/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/Emacs/daemon-error.log</string>
</dict>
</plist>
